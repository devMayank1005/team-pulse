SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SESSION_SECRET=your-random-32-char-secret
CRON_SECRET=your-random-cron-secret

# Optional services
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_ALLOWED_DOMAIN=kognozconsulting.com
# Comma-separated login allowlist, enforced only when non-empty. The users
# table is ALWAYS enforced (SSO never creates accounts), so this is a second
# independent lock. Leave blank to rely on the roster alone.
ALLOWED_LOGIN_EMAILS=mayank@kognozconsulting.com,yashwanth.krishna@kognozconsulting.com,angrah.raina@kognozconsulting.com
AZURE_DEFAULT_MAIL_SENDER=mayank@kognozconsulting.com
RESEND_API_KEY=
REMINDER_FROM_EMAIL=Team Pulse <reminders@yourdomain.com>
# Power Automate "Workflows" trigger URL: in the target Teams channel,
# ... -> Workflows -> "Post to a channel when a webhook request is received".
# Not a classic *.webhook.office.com Connector URL (Microsoft retired those).
TEAMS_WEBHOOK_URL=
APP_URL=https://team-pulse-ruddy.vercel.app
GEMINI_API_KEY=
